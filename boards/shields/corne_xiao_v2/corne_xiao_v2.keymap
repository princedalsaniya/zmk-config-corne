#include "corne_xiao_v2.dtsi"

/ {
    combos {
        compatible = "zmk,combos";
        combo_studio {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp Q          &kp W &kp E &kp R &kp T                 &kp Y &kp U  &kp I     &kp O   &kp P
&kp A          &kp S &kp D &kp F &kp G                 &kp H &kp J  &kp K     &kp L   &kp SEMI
&mt LSHIFT Z   &kp X &kp C &kp V &kp B                 &kp N &kp M  &kp COMMA &kp DOT &mt RSHIFT SLASH
                                  &mo 1 &kp SPACE &kp RET &mo 2
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp N1 &kp N2 &kp N3 &kp N4 &kp N5       &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp DEL
&kp F1 &kp F2 &kp F3 &kp F4 &kp F5       &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                                  &trans &kp SPACE &kp RET &mo 3
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp EXCL  &kp AT   &kp HASH &kp DLLR &kp PRCNT       &kp CARET &kp AMPS  &kp STAR &kp LPAR &kp RPAR
&kp MINUS &kp PLUS &kp LBRC &kp RBRC &kp PIPE        &kp LBKT  &kp RBKT  &kp SEMI &kp COLON &kp SQT
&kp GRAVE &kp TILD &kp BSLH &kp EQUAL &kp UNDER      &kp PLUS  &trans    &trans   &trans    &trans
                                  &mo 3 &kp SPACE &kp RET &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
&bootloader &none &none &none &none       &none &none &none &none &bootloader
&none &none &none &none &none             &none &none &none &none &none
&none &none &none &none &none             &none &none &none &none &none
                                  &trans &none &none &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
