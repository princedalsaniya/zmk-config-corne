#include "corne_xiao_v2.dtsi"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&studio_unlock>;
        };
    };

    macros {

        // ── Window manager ──────────────────────────────────────────
        wm_left: wm_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LALT>
                , <&macro_tap &kp LEFT>
                , <&macro_release &kp LGUI &kp LALT>;
        };

        wm_right: wm_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LALT>
                , <&macro_tap &kp RIGHT>
                , <&macro_release &kp LGUI &kp LALT>;
        };

        wm_f: wm_f {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LALT>
                , <&macro_tap &kp F>
                , <&macro_release &kp LGUI &kp LALT>;
        };

        wm_m: wm_m {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LALT>
                , <&macro_tap &kp M>
                , <&macro_release &kp LGUI &kp LALT>;
        };

        // ── Copy / paste ────────────────────────────────────────────
        cmd_c: cmd_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp C>
                , <&macro_release &kp LGUI>;
        };

        cmd_v: cmd_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp V>
                , <&macro_release &kp LGUI>;
        };

        cmd_opt_c: cmd_opt_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LALT>
                , <&macro_tap &kp C>
                , <&macro_release &kp LGUI &kp LALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─── Layer 0 · Base ─────────────────────────────────────────
        //
        // TAB   Q    W    E    R    T    |    Y    U    I    O    P    ESC
        // SHFT  A    S    D    F    G    |    H    J    K    L    ;    '
        // CTRL  Z    X    C    V    B    |    N    M    ,    .    /    SHFT
        //            MO1  CMD  SPC      |    ENT  BSP  MO2

        default_layer {
            display-name = "base";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp TAB   &kp Q &kp W &kp E &kp R &kp T                     &kp Y   &kp U    &kp I     &kp O   &kp P    &kp ESC
&kp LSHFT &kp A &kp S &kp D &kp F &kp G                     &kp H   &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z &kp X &kp C &kp V &kp B  &none &kp C_MUTE   &kp N   &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                 &mo 1 &kp LGUI &kp SPACE                    &kp RET &kp BSPC &mo 2
            >;
        };

        // ─── Layer 1 · Raise ────────────────────────────────────────
        //
        // BOOT  BT0  BT1  BT2  BT3  CLR  |    1    2    3    ---  UP   ---
        // ---   WM←  WM→  WMF  WMM  ---  |    4    5    6    LFT  DWN  RGT
        // ---   ---  ---  ---  ---  ---  |    7    8    9    ⌘C   ⌘V   ⌘⌥C
        //            MO1  ---  ---       |    ENT  0    ---

        raise_layer {
            display-name = "raise";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&bootloader &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR                  &kp N1  &kp N2  &kp N3  &trans   &kp UP   &trans
&trans      &wm_left     &wm_right    &wm_f        &wm_m        &trans                       &kp N4  &kp N5  &kp N6  &kp LEFT &kp DOWN &kp RIGHT
&trans      &trans       &trans       &trans       &trans       &trans  &none &trans          &kp N7  &kp N8  &kp N9  &cmd_c   &cmd_v   &cmd_opt_c
                         &mo 1        &trans       &trans                                     &kp RET &kp N0  &trans
            >;
        };

        // ─── Layer 2 · Lower ────────────────────────────────────────
        //
        // ---   !    @    #    $    %    |    `    &    (    )    *    ---
        // ---   ---  ---  PRV  PP   NXT  |    -    +    [    ]    \    `
        // ---   ---  ---  MUT  V+   V-   |    _    =    {    }    |    ^
        //            ---  ---  ---       |    ---  ---  ---

        lower_layer {
            display-name = "lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans &kp EXCL &kp AT &kp HASH   &kp DLLR     &kp PRCNT                      &kp GRAVE &kp AMPS  &kp LPAR &kp RPAR &kp STAR &trans
&trans &trans   &trans &kp C_PREV &kp C_PP     &kp C_NEXT                     &kp MINUS &kp PLUS  &kp LBKT &kp RBKT &kp BSLH &kp GRAVE
&trans &trans   &trans &kp C_MUTE &kp C_VOL_UP &kp C_VOL_DN &none &trans      &kp UNDER &kp EQUAL &kp LBRC &kp RBRC &kp PIPE &kp CARET
               &trans  &trans     &trans                                        &trans    &trans    &trans
            >;
        };
    };
};
